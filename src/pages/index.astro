const displayNameMap = new Map(
  sections
    .flatMap((section) => [section.label, ...section.items.map((item) => item.title)])
    .map((value) => [value.toLowerCase(), value]),
);

const acronymMap = new Map([
  ["3d", "3D"],
  ["ai", "AI"],
  ["api", "API"],
  ["c", "C"],
  ["ci", "CI"],
  ["dx", "DX"],
  ["gpu", "GPU"],
  ["github", "GitHub"],
  ["jj", "JJ"],
  ["kv", "KV"],
  ["llm", "LLM"],
  ["ml", "ML"],
  ["os", "OS"],
  ["p2p", "P2P"],
  ["qlora", "QLoRA"],
  ["rl", "RL"],
  ["rlhf", "RLHF"],
  ["rlm", "RLM"],
  ["rpc", "RPC"],
  ["sdk", "SDK"],
  ["simd", "SIMD"],
  ["sft", "SFT"],
  ["tmh", "TMH"],
  ["ux", "UX"],
  ["vllm", "vLLM"],
]);

function formatMetaValue(value: string) {
  const trimmed = value.trim();
  const mapped = displayNameMap.get(trimmed.toLowerCase()) ?? acronymMap.get(trimmed.toLowerCase());

  if (mapped) return mapped;

  return trimmed
    .split(" ")
    .map((word) =>
      word
        .split("-")
        .map((part) => {
          const acronym = acronymMap.get(part.toLowerCase());
          if (acronym) return acronym;
          return part ? `${part.charAt(0).toUpperCase()}${part.slice(1)}` : part;
        })
        .join("-"),
    )
    .join(" ");
}
