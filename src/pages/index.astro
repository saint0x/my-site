<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Saint</title>
    <meta
      name="description"
      content="Minimal engineering portfolio and reading list for Saint."
    />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="site-title" href="/">Saint</a>
        <p class="site-role">Distributed Systems Engineer</p>
      </header>

      <main>
        <section class="about">
          <span class="section-label">About</span>
          <p>{about}</p>
        </section>

        <section class="filters">
          <nav class="filter-row" aria-label="Sections">
            {
              sections.map((section, index) => (
                <button
                  class:list={[
                    "filter-pill",
                    { "is-active": index === 0, "is-disabled": section.id === "blog" },
                  ]}
                  type="button"
                  data-category-trigger
                  data-category={section.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                  disabled={section.id === "blog"}
                >
                  {section.label}
                </button>
              ))
            }
          </nav>
        </section>

        <section class="browser">
          <aside class="timeline" aria-label="Timeline">
            <div class="timeline-list" data-timeline-list></div>
          </aside>

          <div class="details">
            {
              sections.map((section, sectionIndex) => (
                <section
                  class:list={["project-group", { "is-active": sectionIndex === 0 }]}
                  data-category-panel={section.id}
                  hidden={sectionIndex === 0 ? undefined : true}
                >
                  {
                    section.items.map((item, itemIndex) => (
                      <article
                        class:list={["project-entry", { "is-active": itemIndex === 0 }]}
                        id={item.slug}
                        data-project-card
                        data-project-title={item.title}
                        hidden={itemIndex === 0 ? undefined : true}
                      >
                        <span class="project-kind">{item.kind}</span>
                        {
                          item.cover && (
                            <div class="entry-cover-wrap">
                              <div class="cover-slot">{item.cover}</div>
                            </div>
                          )
                        }
                        <h2>{item.title}</h2>
                        <p class="project-blurb">{item.blurb}</p>

                        <ul class="project-points">
                          {item.notes.map((note) => <li>{note}</li>)}
                        </ul>

                        <dl class="meta-list">
                          <div class="meta-row">
                            <dt>Status</dt>
                            <dd>{formatMetaValue(item.status)}</dd>
                          </div>

                          <div class="meta-row">
                            <dt>Tags</dt>
                            <dd class="meta-tags">
                              {item.tags.map((tag) => <span>{formatMetaValue(tag)}</span>)}
                            </dd>
                          </div>

                          {
                            item.related && (
                              <div class="meta-row">
                                <dt>Related</dt>
                                <dd>{item.related.map((value) => formatMetaValue(value)).join(", ")}</dd>
                              </div>
                            )
                          }

                          <div class="meta-row">
                            <dt>Links</dt>
                            <dd class="meta-links">
                              {item.links && item.links.length > 0 ? (
                                item.links.map((link) =>
                                  link.href ? (
                                    <a href={link.href} target="_blank" rel="noreferrer">
                                      {formatMetaValue(link.label)}
                                    </a>
                                  ) : (
                                    <span>{formatMetaValue(link.label)}</span>
                                  ),
                                )
                              ) : (
                                <span class="meta-empty">None Yet</span>
                              )}
                            </dd>
                          </div>

                          {
                            section.id === "projects" && (
                              <div class="meta-row meta-row--graph">
                                <dt>Graph</dt>
                                <dd>
                                  <CommitGraph
                                    graphId={item.slug}
                                    repo={item.repo}
                                    points={projectCommitGraphs[item.slug as keyof typeof projectCommitGraphs]}
                                  />
                                </dd>
                              </div>
                            )
                          }

                        </dl>
                      </article>
                    ))
                  }
                </section>
              ))
            }
          </div>
        </section>
      </main>
    </div>

    <script>
      const triggers = Array.from(document.querySelectorAll("[data-category-trigger]"));
      const panels = Array.from(document.querySelectorAll("[data-category-panel]"));
      const timelineList = document.querySelector("[data-timeline-list]");

      let activeCategory = triggers[0]?.dataset.category;
      let activeTimelineButtons = [];
      let activeCards = [];

      function setActiveProject(cardId) {
        activeCards.forEach((card) => {
          const isCurrent = card.id === cardId;
          card.hidden = !isCurrent;
          card.classList.toggle("is-active", isCurrent);
        });

        activeTimelineButtons.forEach((button) => {
          const isCurrent = button.dataset.target === cardId;
          button.classList.toggle("is-current", isCurrent);
          button.setAttribute("aria-current", isCurrent ? "true" : "false");
        });
      }

      function buildTimeline(categoryId) {
        const panel = panels.find((entry) => entry.dataset.categoryPanel === categoryId);
        if (!panel || !timelineList) return;

        activeCards = Array.from(panel.querySelectorAll("[data-project-card]"));
        timelineList.innerHTML = "";

        activeTimelineButtons = activeCards.map((card, index) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "timeline-item";
          button.dataset.target = card.id;
          button.setAttribute("aria-current", index === 0 ? "true" : "false");
          button.innerHTML = `
            <span class="timeline-item__dot" aria-hidden="true"></span>
            <span class="timeline-item__text">
              <span class="timeline-item__title">${card.dataset.projectTitle ?? ""}</span>
            </span>
          `;

          button.addEventListener("click", () => {
            setActiveProject(card.id);
          });

          timelineList.appendChild(button);
          return button;
        });

        setActiveProject(activeCards[0]?.id);
      }

      function setCategory(categoryId) {
        activeCategory = categoryId;

        triggers.forEach((trigger) => {
          const isActive = trigger.dataset.category === categoryId;
          trigger.classList.toggle("is-active", isActive);
          trigger.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.categoryPanel === categoryId;
          panel.hidden = !isActive;
          panel.classList.toggle("is-active", isActive);

          if (!isActive) {
            panel.querySelectorAll("[data-project-card]").forEach((card) => {
              card.hidden = true;
              card.classList.remove("is-active");
            });
          }
        });

        buildTimeline(categoryId);
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const nextCategory = trigger.dataset.category;
          if (!nextCategory || nextCategory === activeCategory) return;
          setCategory(nextCategory);
        });
      });

      if (activeCategory) {
        setCategory(activeCategory);
      }
    </script>
  </body>
</html>

